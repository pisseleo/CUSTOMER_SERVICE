# API
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=true

# OIDC / Auth
# Use the proxy for local API requests to avoid CORS issues.
# VITE_API_BASE_URL=http://localhost:8081

VITE_OIDC_AUTHORITY=http://localhost:8080/realms/customer-service
VITE_OIDC_CLIENT_ID=frontend

VITE_OIDC_REDIRECT_URI=http://localhost:5173
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

VITE_OIDC_RESPONSE_TYPE=code
VITE_OIDC_SCOPE=openid profile email

VITE_OIDC_AUDIENCE=customer-service-api

VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:5173/silent-renew.html

# Optional mock fallback
VITE_USE_MOCK_API=true
