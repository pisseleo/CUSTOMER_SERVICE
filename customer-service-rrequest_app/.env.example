# --- API ---
# Base URL of the customer service request API this SPA consumes.
# Expected endpoints (see src/api/requests.ts for exact contract):
#   GET   /requests?page=&pageSize=&search=&status=&priority=&sortBy=&sortDir=
#   GET   /requests/:id
#   POST  /requests
#   PATCH /requests/:id/status   body: { status, version }
VITE_API_BASE_URL=https://api.example.com/api

# Set to "true" to run entirely against an in-browser mock (localStorage),
# useful for local development/demo before a real API is available.
VITE_USE_MOCK_API=false

# --- OpenID Connect ---
# Works with any standards-compliant OIDC provider (Keycloak, Auth0, Okta,
# Azure AD B2C, etc). Point these at your provider/client registration.

# Keycloak example:
#   VITE_OIDC_AUTHORITY=https://keycloak.example.com/realms/customer-service
# Auth0 example:
#   VITE_OIDC_AUTHORITY=https://your-tenant.eu.auth0.com/
VITE_OIDC_AUTHORITY=https://your-oidc-provider.example.com/realms/customer-service

VITE_OIDC_CLIENT_ID=customer-service-spa

# Must be registered as an allowed redirect URI on the OIDC client.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# Must be registered as an allowed post-logout redirect URI.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

VITE_OIDC_SCOPE=openid profile email

# Only needed by some providers (e.g. Auth0) to receive an access token
# scoped to your API instead of the provider's userinfo endpoint.
# VITE_OIDC_AUDIENCE=https://api.example.com
